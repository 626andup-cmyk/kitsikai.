    { "id": "dispersion", "label": "Rainbow edges", "variable": "--dispersion", "min": 0, "max": 1, "step": 0.05, "default": 0.6 },
    { "id": "frost", "label": "Frost", "variable": "--frost", "min": 0, "max": 20, "step": 0.5, "default": 0.5 },
    { "id": "neon", "label": "Neon", "variable": "--neon", "min": 0, "max": 1, "step": 0.05, "default": 1 },
    { "id": "smoke", "label": "Smoke", "variable": "--smoke", "min": 0, "max": 1, "step": 0.05, "default": 1 }
  ]
